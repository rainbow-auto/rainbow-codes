    "version": "2.0.0",
    "tasks": [
        {
            "label": "cp run",
            "type": "shell",
            "command": "cd ${fileDirnameBasename} && g++-15 ${fileBasename} -O2 -std=c++14 -o ${fileBasenameNoExtension} && ./${fileBasenameNoExtension}",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}